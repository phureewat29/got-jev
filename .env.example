# TypeSafe (Jev) — https://docs.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_MS=10000

# OpenRouter — narrator model
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Storage — Redis.
REDIS_URL=redis://127.0.0.1:6379
STORY_TTL_DAYS=7

# Story engine
MAX_TURNS=15
MAX_TURNS_PER_DAY=500
# Per-caller ceilings; a new tale mints a new session, so only the IP is durable
MAX_TURNS_PER_MINUTE=10
MAX_TURNS_PER_IP_PER_DAY=60

# ElevenLabs Music — only needed to (re)generate the mood tracks
ELEVENLABS_API_KEY=

# Optional. Serve music and scene artwork from a CDN; unset uses public/
NEXT_PUBLIC_CDN_URL=

# Cloudflare R2 — only needed to run scripts/push-assets.ts
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=jev
